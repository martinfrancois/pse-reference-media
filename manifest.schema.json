{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinfrancois/pse-reference-media/manifest.schema.json",
  "title": "Reference clip manifest",
  "description": "One entry per file in clips/: where it came from, under which licence, how it was cut and what ffprobe reports about it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ffmpeg", "clips"],
  "properties": {
    "schema_version": {"const": 1},
    "ffmpeg": {
      "description": "The ffmpeg build used to cut the clips and to record the facts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build"],
      "properties": {
        "version": {"type": "string"},
        "build": {"type": "string"}
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clip"}
    }
  },
  "$defs": {
    "sha3": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "url": {"type": "string", "pattern": "^https?://"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "nullable_string": {"type": ["string", "null"]},
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha3_256", "size", "title", "author", "note", "covers", "licence", "source", "cut", "video_stream", "facts"],
      "properties": {
        "file": {"type": "string", "pattern": "^clips/[a-z0-9][a-z0-9-]*\\.(mov|mkv|mp4|mpg|webm|gif|png|webp|avif)$"},
        "sha3_256": {"$ref": "#/$defs/sha3"},
        "size": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "description": "Title of the source work."},
        "author": {"type": "string"},
        "note": {"type": "string", "description": "What the clip shows and why it is in the set."},
        "covers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "statement_url", "read_on", "attribution", "changes"],
          "properties": {
            "name": {"type": "string", "description": "For example \"CC BY 3.0\" or \"Public domain\"."},
            "url": {"$ref": "#/$defs/url", "description": "The licence text, or the public-domain statement relied on."},
            "statement_url": {"$ref": "#/$defs/url", "description": "The page where the rights holder or host states the licence for this work."},
            "other_statements": {"type": "array", "items": {"$ref": "#/$defs/url"}},
            "read_on": {"$ref": "#/$defs/date", "description": "The date the statement page was read."},
            "attribution": {"$ref": "#/$defs/nullable_string", "description": "The credit line in the form the licence or the rights holder asks for; null when none is required."},
            "changes": {"type": "string", "description": "What was changed relative to the source file."}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "page", "file_name", "size", "sha3_256"],
          "properties": {
            "url": {"$ref": "#/$defs/url", "description": "Direct download URL of the source file."},
            "page": {"$ref": "#/$defs/url", "description": "Human-readable page describing the source."},
            "file_name": {"type": "string"},
            "size": {"type": "integer", "minimum": 1},
            "sha3_256": {
              "oneOf": [{"$ref": "#/$defs/sha3"}, {"type": "null"}],
              "description": "null only for a remote cut, where the source was not downloaded in full."
            },
            "remote_cut": {"type": "boolean", "description": "true when ffmpeg read the needed part of the source over HTTP."},
            "published_digests": {
              "type": "object",
              "description": "Digests the host publishes for the source file, by algorithm name.",
              "additionalProperties": {"type": "string"}
            },
            "archive_member": {
              "type": "object",
              "description": "Set when the source URL is a zip archive; the cut reads this member.",
              "additionalProperties": false,
              "required": ["name", "size", "sha3_256"],
              "properties": {
                "name": {"type": "string"},
                "size": {"type": "integer", "minimum": 1},
                "sha3_256": {"$ref": "#/$defs/sha3"}
              }
            }
          }
        },
        "cut": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "start", "duration", "command", "ffmpeg_version"],
          "properties": {
            "method": {"enum": ["stream-copy", "re-encode", "whole-file"]},
            "start": {"$ref": "#/$defs/nullable_string", "description": "Seek position in the source in seconds, as passed to -ss; null when the whole source is used."},
            "duration": {"$ref": "#/$defs/nullable_string", "description": "Duration in seconds, as passed to -t; null when the whole source is used."},
            "command": {
              "oneOf": [{"type": "array", "items": {"type": "string"}, "minItems": 2}, {"type": "null"}],
              "description": "ffmpeg arguments; {input} and {output} stand for the source and the clip. null for whole-file copies."
            },
            "ffmpeg_version": {"$ref": "#/$defs/nullable_string"},
            "quality": {"type": "string", "description": "For re-encodes: how close the result is to the source, as measured."}
          }
        },
        "video_stream": {"type": "integer", "minimum": 0, "description": "Index of the stream the facts describe."},
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container", "codec", "profile", "width", "height", "sample_aspect_ratio", "frame_rate", "average_frame_rate", "scan", "pixel_format", "bit_depth", "color_primaries", "color_transfer", "color_matrix", "color_range", "frame_count", "duration"],
          "properties": {
            "container": {"$ref": "#/$defs/nullable_string"},
            "codec": {"$ref": "#/$defs/nullable_string"},
            "profile": {"$ref": "#/$defs/nullable_string"},
            "width": {"type": ["integer", "null"]},
            "height": {"type": ["integer", "null"]},
            "sample_aspect_ratio": {"$ref": "#/$defs/nullable_string"},
            "frame_rate": {"$ref": "#/$defs/nullable_string"},
            "average_frame_rate": {"$ref": "#/$defs/nullable_string"},
            "scan": {"$ref": "#/$defs/nullable_string"},
            "pixel_format": {"$ref": "#/$defs/nullable_string"},
            "bit_depth": {"type": ["integer", "null"]},
            "color_primaries": {"$ref": "#/$defs/nullable_string"},
            "color_transfer": {"$ref": "#/$defs/nullable_string"},
            "color_matrix": {"$ref": "#/$defs/nullable_string"},
            "color_range": {"$ref": "#/$defs/nullable_string"},
            "frame_count": {"type": ["integer", "null"]},
            "duration": {"$ref": "#/$defs/nullable_string"}
          }
        }
      }
    }
  }
}
